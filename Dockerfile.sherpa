# Build the existing SHERPA renderer and its authenticated sidecar connector.
# The provider key and bridge token are runtime inputs; neither is copied into
# this image.
FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.sherpa.config.ts sherpa.html ./
COPY server ./server
COPY src ./src
RUN npm run build:sherpa

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV SHERPA_VOICE_PORT=8791

# Keep the runtime self-contained so the same image can run as an ECS task
# sidecar. The connector API still binds to loopback in server/sherpa-embed.ts.
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist-sherpa ./dist-sherpa
COPY --from=build /app/server ./server
COPY --from=build /app/src ./src

# The company-owned usage observer is deliberately not copied from this
# personal repository. An approved private build may add its complete import
# graph under /app/company-hooks (voice-monitor.mjs, voice-pricing.mjs,
# index.mjs, pricing.mjs, pricing.json, transport.mjs, and schema.sql), retain
# the ws dependency, and set SHERPA_VOICE_USAGE_MODULE to the file URL of
# voice-monitor.mjs at runtime. Without that hook, hosted readiness remains
# false and no claim of recorded cost coverage is made.

EXPOSE 8791
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8791/healthz').then(async r=>{const body=await r.json().catch(()=>null);process.exit(r.ok&&body?.ready===true?0:1)}).catch(()=>process.exit(1))"

CMD ["npm", "run", "start:sherpa"]
